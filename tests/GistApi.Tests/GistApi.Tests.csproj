<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test project targeting .NET 10 using xUnit -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Enable nullable reference type annotations used by the fake HTTP handler -->
    <Nullable>enable</Nullable>
    <!-- Prevent packing the test project as a NuGet package -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test SDK and test framework packages -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
    <PackageReference Include="FluentAssertions" Version="6.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference to the API project so tests can run against it -->
    <ProjectReference Include="..\..\src\GistApi\GistApi.csproj" />
  </ItemGroup>
</Project>
